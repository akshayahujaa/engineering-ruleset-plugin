{
  "baseline": {
    "rulesetName": "Pull Request Compulsion",
    "includeDefaultBranch": true,
    "requirePullRequest": true,
    "requiredApprovals": 0,
    "preventDeletion": true,
    "preventForcePush": true,
    "allowedMergeMethods": [
      "merge",
      "squash",
      "rebase"
    ],
    "statusChecks": [
      "scope-check"
    ],
    "statusCheckRuleset": "PR-SCOPE-CHECK",
    "statusCheckSecrets": [
      "OPENROUTER_API_KEY"
    ]
  },
  "environments": {
    "dev": {}
  },
  "environmentProfiles": {
    "test": {},
    "prod": {
      "requiredApprovals": 1,
      "reviewerTeams": [
        "tehvault/reviewers"
      ],
      "reviewerRuleset": "team-only-reviewer"
    }
  },
  "teamSeeding": {
    "fromCodeowners": true,
    "includeRunner": "fallback",
    "populateEmptyTeams": true
  },
  "taskSync": {
    "enabled": true,
    "provider": "clickup",
    "taskIdPrefix": "",
    "todoStatuses": [
      "to do",
      "todo",
      "open",
      "backlog",
      "pending"
    ],
    "branchPushStatus": "in progress",
    "environmentStatuses": {
      "dev": "dev",
      "test": "QA",
      "prod": [
        "done",
        "complete",
        "completed"
      ]
    },
    "secretName": "CLICKUP_TOKEN"
  },
  "prChecks": {
    "scopeCheck": {
      "enabled": true,
      "aiProvider": "openrouter",
      "aiModel": "qwen/qwen3-coder",
      "aiKeySecret": "OPENROUTER_API_KEY",
      "requireTask": true,
      "failOpenOnError": false,
      "maxDiffChars": 60000,
      "autoCloseOutOfScope": true
    },
    "prAgent": {
      "enabled": true,
      "model": "openrouter/qwen/qwen3-coder",
      "fallbackModels": [
        "openrouter/qwen/qwen-2.5-72b-instruct"
      ],
      "maxTokens": 32000,
      "numCodeSuggestions": 4,
      "keySecret": "OPENROUTER_API_KEY",
      "securityGate": true
    },
    "trivy": {
      "enabled": true,
      "severities": [
        "CRITICAL",
        "HIGH",
        "MEDIUM"
      ],
      "blockOn": [
        "CRITICAL"
      ],
      "blockScope": "changed-files",
      "scanners": [
        "vuln",
        "secret",
        "misconfig"
      ],
      "ignoreUnfixed": true,
      "actionVersion": "v0.36.0",
      "statusCheck": "trivy-security",
      "rulesetName": "TRIVY-SECURITY",
      "skipDirs": [
        "node_modules",
        "dist",
        "build",
        "vendor"
      ],
      "timeout": "10m"
    },
    "strix": {
      "enabled": true,
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "keySecret": "OPENROUTER_API_KEY",
      "scanMode": "quick",
      "packageVersion": "1.5.3",
      "pythonVersion": "3.12",
      "timeoutMinutes": 45
    }
  },
  "branchNaming": {
    "rulesetName": "Enforce Branch Nomenclature",
    "allowedPrefixes": [
      "feature",
      "bugfix",
      "hotfix",
      "docs",
      "chore"
    ],
    "requireTaskId": true,
    "taskIdPrefix": "",
    "requireDescription": true,
    "restrictCreation": true,
    "preventForcePush": true,
    "requiredApprovals": 1,
    "reviewerTeams": [
      "tehvault/reviewers"
    ]
  }
}
